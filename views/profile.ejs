<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-900">
    <div class="text-white w-full p-10">
        <div class="flex justify-between items-center">
            <div>
                <div class="overflow-hidden rounded-full w-20 h-20">
                    <img src="/images/uploads/<%= user.profilepic %>" alt="">
                </div>
                <a href="/profile/upload">chage Profile</a>
            </div>
            <a class="bg-red-500 h-9 rounded px-5 py-1" href="/logout">Logout</a>
        </div>
        <h1 class="text-4xl font-semibold mt-5 mb-5"> Hello, <%= user.username %></h1>
        <h3>you can create a new post</h3>
        <div>
            <form action="/post" method="post">
                <textarea class="w-1/2 p-3 rounded-md mt-5 resize-none block border border-zinc-600 outline-none" name="content" placeholder="Write about new post" id=""></textarea>
                <button class="bg-blue-500 px-5 py-1 mt-3 block rounded-md ">Create New Post</button>
            </form>
        </div>
        <h4 class="text-zinc-400 mt-5">Your Posts.</h4>
        <% user.post.reverse().forEach(function(post){ %>
            <div class="border bg-zinc-800 border-zinc-600 mt-3 p-3 rounded-md ">
            <h3 class="mb-2 text-blue-400">@<%= user.username %></h3>
            <p class="text-sm "><%= post.content %></p>
            <p class="text-sm mt-3"><%= post.likes.length %> likes</p>
            <div class=" flex gap-7">
                <a class="text-red-400 w-1/6" href="/like/<%= post._id %>">
                    <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %>
                </a>
                <a class="text-zinc-400" href="/edit/<%= post._id %>">Edit</a>
            </div>
        </div>
        <% }) %>
        
    </div>
</body>
</html