<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-900">
    <div class="text-white w-full p-10">
        <h1 class="text-4xl font-semibold mt-5 mb-5">Upload Profile Pic</h1>
        <form action="/upload" method="post" enctype="multipart/form-data" class="flex gap-3 flex-wrap">
            <input type="file" name="image">
            <button class="px-5 py-2 bg-blue-500 rounded-md">Upload</button>
        </form>
    </div>
</body>
</html>