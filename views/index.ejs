<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-900">
    <div class="text-white w-full p-10">
        <a class="text-blue-500 underline" href="/login">Login</a>
        <h1 class="text-4xl font-semibold mt-5 mb-5">Create Your Account</h1>
        <form action="/register" method="post" class="flex gap-3 flex-wrap">
            <input class="px-3 py-2 border border-zinc-500 rounded-md " type="text" placeholder="username" name="username">
            <input class="px-3 py-2 border border-zinc-500 rounded-md " type="text" placeholder="name" name="name">
            <input class="px-3 py-2 border border-zinc-500 rounded-md " type="email" placeholder="email" name="email">
            <input class="px-3 py-2 border border-zinc-500 rounded-md " type="password" placeholder="password" name="password">
            <input class="px-3 py-2 border border-zinc-500 rounded-md " type="number" placeholder="age" name="age">
            <button class="px-5 py-2 bg-blue-500 rounded-md">Create Account</button>
        </form>
    </div>
</body>
</html>