<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-900">
    <div class="bg-zinc-900 h-screen text-white w-full p-10">
        <div class="flex justify-end">
            <a class="bg-red-500 rounded px-5 py-1" href="/logout">Logout</a>
        </div>
        <h3>Edit your post</h3>
        <div>
            <form action="/update/<%= post._id %>" method="post">
                <textarea class="w-1/2 p-3 rounded-md mt-5 resize-none block border border-zinc-600 outline-none" name="content" placeholder="Write about new post" id=""><%= post.content %></textarea>
                <button class="bg-yellow-500 text-black px-5 py-1 mt-3 block rounded-md ">Update Post</button>
            </form>
        </div>
    </div>
</body>
</html>